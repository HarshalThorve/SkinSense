# ============================================
# SkinSense Environment Variables
# ============================================
# IMPORTANT: Never commit this file to git!
# Copy this to .env and fill in your values.

# Flask secret key (generate a random one for production)
SECRET_KEY=change-me-to-a-random-string

# Gemini API Key (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# Debug mode (set to "true" only for local development)
FLASK_DEBUG=true

# Tesseract OCR path (Windows only, leave empty for Linux/Mac)
# TESSERACT_CMD=C:\Users\kunal\AppData\Local\Programs\Tesseract-OCR\tesseract.exe
